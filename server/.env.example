# Server Port (default 5005)
PORT=5005

# MongoDB Connection String — Get from MongoDB Atlas Dashboard (Database -> Connect -> Drivers) or local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/revive

# Alternative MongoDB Connection String Alias — Alias for MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/revive

# JWT Secret — Generate any secure random string or secret passkey for token signing
JWT_SECRET=your_jwt_secret_key_here

# Groq API Key — Get from Groq Console (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key

# OpenAI API Key — Get from OpenAI Platform (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your_openai_api_key

# OpenRouter API Key — Get from OpenRouter Dashboard (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key

# AI Model Identifier — Model name override (e.g., llama-3.3-70b-versatile, gpt-4o-mini)
AI_MODEL=llama-3.3-70b-versatile

# Razorpay Test Key ID — Get from Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Razorpay Test Key Secret — Get from Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Telegram Bot Token — Get from Telegram @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Chat ID — Get via Telegram getUpdates API or @userinfobot (https://t.me/userinfobot)
TELEGRAM_CHAT_ID=123456789

# SMTP Host — Get from your email provider settings (e.g., smtp.gmail.com for Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP Port — Get from your email provider settings (e.g., 587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP User — Sender email address used for Nodemailer authentication
SMTP_USER=your_email@gmail.com

# SMTP Password — App password generated from Google Account -> Security -> App passwords
SMTP_PASS=your_app_password

# SMTP From Header — Formatted sender name and email string for outgoing recovery emails
SMTP_FROM="Revive AI Revenue Recovery" <your_email@gmail.com>

# Frontend Client URL — Origin URL of the React frontend app used for CORS and link generation
CLIENT_URL=http://localhost:5173
