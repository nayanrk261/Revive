# Revive — Backend Environment Configuration Example
# Copy this file to server/.env and adjust values for your environment.

# Server Port
PORT=5005

# MongoDB Connection String — Local MongoDB or MongoDB Atlas URI
# From MongoDB Atlas Dashboard -> Database -> Connect -> Connect your application
MONGODB_URI=mongodb://127.0.0.1:27017/revive

# JWT Secret — Used to sign and verify authentication tokens for multi-tenant isolation
# Replace with any long, random, secure string
JWT_SECRET=replace_with_a_long_random_string_revive_2026

# AI / LLM Integration — Groq (Primary), OpenAI, or OpenRouter
GROQ_API_KEY=gsk_your_groq_api_key
OPENAI_API_KEY=your_openai_or_openrouter_key
# OPENROUTER_API_KEY=your_openrouter_key_if_using_openrouter
# AI_MODEL=llama-3.3-70b-versatile


# Razorpay Integration — From Razorpay Dashboard -> Test Mode -> Account Settings -> API Keys
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# SMTP Email Service — Nodemailer configuration for real dunning reminder emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Google Account -> Security -> 2-Step Verification -> App Passwords (NOT your main account password)
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Revive AI Revenue Recovery" <your_email@gmail.com>

# Frontend Origin URL — Used for CORS policy configuration in production
CLIENT_URL=http://localhost:5173

# Telegram Bot API — Instant notification channel for demo
# Create bot via @BotFather on Telegram, then get your numeric chat ID via getUpdates API
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

